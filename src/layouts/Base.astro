---
import '../styles/global.css';
import { restaurant as r } from '../data/restaurant';
import { fullAddress } from '../lib/format';

const site = (Astro.site?.href ?? '').replace(/\/$/, '');
const dayNames = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: r.fullName,
  description: r.seo.description,
  url: site,
  image: `${site}/og.jpg`,
  telephone: r.contact.phoneHref,
  priceRange: r.priceRange,
  servesCuisine: ['Japonesa', 'Sushi'],
  acceptsReservations: true,
  hasMenu: `${site}/#cardapio`,
  menu: `${site}/#cardapio`,
  sameAs: [`https://instagram.com/${r.contact.instagram}`],
  address: {
    '@type': 'PostalAddress',
    streetAddress: r.contact.address.street,
    addressLocality: r.contact.address.city,
    addressRegion: r.contact.address.state,
    postalCode: r.contact.address.zip,
    addressCountry: r.contact.address.country,
  },
  openingHoursSpecification: r.hours.flatMap((h, i) =>
    h ? [{ '@type': 'OpeningHoursSpecification', dayOfWeek: dayNames[i], opens: h.open, closes: h.close === '24:00' ? '23:59' : h.close }] : []
  ),
  ...(r.google ? { aggregateRating: { '@type': 'AggregateRating', ratingValue: r.google.rating, reviewCount: r.google.count } } : {}),
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{r.seo.title}</title>
    <meta name="description" content={r.seo.description} />
    <link rel="canonical" href={`${site}/`} />
    <meta name="theme-color" content="#080808" />
    <meta name="color-scheme" content="dark" />

    <meta property="og:type" content="restaurant" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={r.fullName} />
    <meta property="og:title" content={r.seo.title} />
    <meta property="og:description" content={r.seo.description} />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:image" content={`${site}/og.jpg`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${r.fullName} — ${r.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={`${site}/og.jpg`} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Manrope:wght@400;500;600;700&display=swap"
    />
    <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?family=Shippori+Mincho&display=swap&text=${encodeURIComponent(r.signature.kanji + '栞')}`} />

    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <meta name="geo.placename" content={fullAddress()} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
  </body>
</html>
