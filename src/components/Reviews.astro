---
import { restaurant as r } from '../data/restaurant';
import SectionLabel from './SectionLabel.astro';
const g = r.google;
---
{g && (
  <section class="section" id="avaliacoes" aria-labelledby="avaliacoes-title">
    <div class="container reviews">
      <div>
        <SectionLabel text="Avaliações no Google" />
        <h2 class="sr-only" id="avaliacoes-title">Avaliações</h2>
        <p class="reviews__score">{g.rating.toLocaleString('pt-BR', { minimumFractionDigits: 1 })}</p>
        <p class="muted">
          {g.count.toLocaleString('pt-BR')} avaliações ·{' '}
          <a class="link-line" href={g.url} target="_blank" rel="noopener">ver no Google</a>
        </p>
      </div>
      <div class="reviews__list">
        {g.reviews.map((rv) => (
          <figure class="review" data-reveal="fade">
            <blockquote>“{rv.text}”</blockquote>
            <figcaption>{rv.author}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
