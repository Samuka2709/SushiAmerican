---
import { restaurant as r } from '../data/restaurant';
import SectionLabel from './SectionLabel.astro';
const g = r.google;
---
{g && (
  <section class="section" id="recensioni" aria-labelledby="recensioni-title">
    <div class="container reviews">
      <div>
        <SectionLabel text="Recensioni su Google" />
        <h2 class="sr-only" id="recensioni-title">Recensioni</h2>
        <p class="reviews__score">{g.rating.toLocaleString('it-IT', { minimumFractionDigits: 1 })}</p>
        <p class="muted">
          {g.count.toLocaleString('it-IT')} recensioni ·{' '}
          <a class="link-line" href={g.url} target="_blank" rel="noopener">vedi su Google</a>
        </p>
      </div>
      <div class="reviews__list">
        {g.reviews.map((rv) => (
          <figure class="review" data-reveal="fade">
            <blockquote>“{rv.text}”</blockquote>
            <figcaption>{rv.author}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
