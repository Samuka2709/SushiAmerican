---
import { restaurant as r } from '../data/restaurant';
import Photo from './Photo.astro';
import SectionLabel from './SectionLabel.astro';
const a = r.about;
---
<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container">
    <div class="about__grid">
      <div class="about__photos">
        <div class="about__photo about__photo--a" data-parallax="-8">
          <Photo photo={a.photos[0]} ratio={4 / 5} widths={[400, 640, 900, 1200]} sizes="(min-width: 900px) 36vw, 72vw" />
        </div>
        <div class="about__photo about__photo--b" data-parallax="12">
          <Photo photo={a.photos[1]} ratio={1} widths={[320, 480, 720, 960]} sizes="(min-width: 900px) 26vw, 52vw" />
        </div>
      </div>

      <div class="about__text">
        <span class="kanji" aria-hidden="true">栞</span>
        <SectionLabel num="01" text={a.label} />
        <h2 class="display h2 about__title reveal-words" id="about-title" data-split-auto>{a.title}</h2>
        <div class="about__body">
          {a.paragraphs.map((p) => <p data-reveal="fade">{p}</p>)}
        </div>
      </div>
    </div>

    <ol class="pillars">
      {a.pillars.map((p, i) => (
        <li class="pillar" data-reveal="fade">
          <span class="pillar__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="h3">{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ol>

    <dl class="stats">
      {a.stats.map((s) => (
        <div class="stat" data-reveal="fade">
          <dt class="sr-only">{s.label}</dt>
          <dd class="stat__value" data-count={s.value}>{s.value.toLocaleString('en-US')}{s.suffix}</dd>
          <dd class="stat__label" aria-hidden="true">{s.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
