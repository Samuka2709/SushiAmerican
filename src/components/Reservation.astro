---
import { restaurant as r } from '../data/restaurant';
import Photo from './Photo.astro';
import SectionLabel from './SectionLabel.astro';
import Icon from './Icon.astro';
const res = r.reservation;
const people = Array.from({ length: 11 }, (_, i) => i + 1);
---
<section class="section section--alt" id="reservas" aria-labelledby="reservas-title">
  <div class="container reserve__grid">
    <div>
      <SectionLabel num="05" text="Reservas" />
      <h2 class="display h2 reveal-words reserve__title" id="reservas-title" data-split-auto>{res.title}</h2>
      <p class="lead reserve__lead" data-reveal="fade">{res.text}</p>
      <Photo photo={res.photo} ratio={4 / 5} widths={[400, 640, 900, 1200]} sizes="(min-width: 900px) 40vw, 100vw" class="reserve__media" />
    </div>

    <div class="reserve__form-wrap" data-reveal="fade">
      <form class="form" novalidate data-reserve-form>
        <div class="field">
          <label for="rs-name">Nome <span class="req" aria-hidden="true">*</span></label>
          <input class="input" id="rs-name" name="name" type="text" autocomplete="name" required aria-describedby="rs-name-err" />
          <p class="field__error" id="rs-name-err"></p>
        </div>

        <div class="field field--half">
          <label for="rs-phone">Telefone <span class="req" aria-hidden="true">*</span></label>
          <input class="input" id="rs-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="(73) 99999-9999" required aria-describedby="rs-phone-err" />
          <p class="field__error" id="rs-phone-err"></p>
        </div>

        <div class="field field--half">
          <label for="rs-people">Pessoas <span class="req" aria-hidden="true">*</span></label>
          <select class="input" id="rs-people" name="people" required aria-describedby="rs-people-err">
            {people.map((n) => <option value={String(n)} selected={n === 2}>{n} {n === 1 ? 'pessoa' : 'pessoas'}</option>)}
            <option value="12+">12 ou mais</option>
          </select>
          <p class="field__error" id="rs-people-err"></p>
        </div>

        <div class="field field--half">
          <label for="rs-date">Data <span class="req" aria-hidden="true">*</span></label>
          <input class="input" id="rs-date" name="date" type="date" required aria-describedby="rs-date-hint rs-date-err" />
          <p class="field__hint" id="rs-date-hint" data-closed-hint></p>
          <p class="field__error" id="rs-date-err"></p>
        </div>

        <div class="field field--half">
          <label for="rs-time">Horário <span class="req" aria-hidden="true">*</span></label>
          <select class="input" id="rs-time" name="time" required disabled aria-describedby="rs-time-err">
            <option value="">Escolha a data primeiro</option>
          </select>
          <p class="field__error" id="rs-time-err"></p>
        </div>

        <div class="field">
          <label for="rs-notes">Observações</label>
          <textarea class="input" id="rs-notes" name="notes" rows="3" placeholder="Aniversário, restrição alimentar, preferência pelo balcão..."></textarea>
        </div>

        <div class="form__submit">
          <p class="sr-only" role="status" aria-live="polite" data-form-status></p>
          <button class="btn btn--primary btn--block" type="submit">
            <Icon name="whatsapp" class="btn__arrow" /> Enviar pedido de reserva
          </button>
          <p class="reserve__note">
            <Icon name="info" />
            <span>{res.note}</span>
          </p>
          <p class="form__fineprint">Ao enviar, o WhatsApp abre com a mensagem pronta. Nada é confirmado automaticamente.</p>
        </div>
      </form>
    </div>
  </div>
</section>
