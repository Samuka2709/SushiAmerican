---
import { restaurant as r } from '../data/restaurant';
import { whatsappLink, genericOrderMessage, fullAddress, instagramUrl } from '../lib/format';
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer__cols">
      <div class="footer__col">
        <h2 class="label">{r.fullName}</h2>
        <p class="footer__tagline">{r.tagline}</p>
        <p class="footer__address">{fullAddress()}</p>
      </div>
      <nav class="footer__col" aria-label="Rodapé">
        <h2 class="label">Navegar</h2>
        <ul>
          {r.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>
      <div class="footer__col">
        <h2 class="label">Contato</h2>
        <ul>
          <li><a href={whatsappLink(genericOrderMessage())} target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a href={`tel:${r.contact.phoneHref}`}>{r.contact.phone}</a></li>
          <li><a href={instagramUrl()} target="_blank" rel="noopener">@{r.contact.instagram}</a></li>
        </ul>
      </div>
      <div class="footer__col">
        <h2 class="label">Reservas</h2>
        <ul>
          <li><a href="#reservas">Reservar uma mesa</a></li>
          <li><a href="#assinatura">Omakase no balcão</a></li>
        </ul>
      </div>
    </div>

    <p class="footer__name" aria-hidden="true">{r.name}</p>

    <div class="footer__bottom">
      <span>© {year} {r.footer.copyright}. Todos os direitos reservados.</span>
      <a href="#topo" class="link-line" data-scroll-link>Voltar ao topo</a>
    </div>
  </div>
</footer>
