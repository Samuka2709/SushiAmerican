---
import { restaurant as r } from '../data/restaurant';
import { price } from '../lib/format';
import Photo from './Photo.astro';
import SectionLabel from './SectionLabel.astro';
import Icon from './Icon.astro';
---
<section class="section section--alt" id="barche" aria-labelledby="barche-title">
  <div class="container">
    <header class="section-head section-head--split">
      <div>
        <SectionLabel num="03" text="Barche" />
        <h2 class="display h2 section-head__title reveal-words" id="barche-title" data-split-auto>{r.sections.combos.title}</h2>
      </div>
      <p class="lead" data-reveal="fade">{r.sections.combos.lead}</p>
    </header>

    <ul class="combos">
      {r.combos.map((c) => (
        <li class:list={['combo', { 'combo--featured': c.featured }]} data-reveal="fade">
          {c.featured && <span class="tag tag--top">Più richiesta</span>}
          <Photo photo={c.photo} ratio={16 / 10} widths={[400, 640, 900]} sizes="(min-width: 1024px) 30vw, 100vw" reveal={false} />
          <div class="combo__body">
            <h3 class="combo__name">Barca {c.name}</h3>
            <p class="combo__pieces">{c.pieces} pezzi</p>
            <p class="combo__price">{price(c.price)}</p>
            <ul class="combo__includes" aria-label={`Cosa contiene la Barca ${c.name}`}>
              {c.includes.map((i) => <li>{i}</li>)}
            </ul>
            <button
              class:list={['btn btn--block', c.featured ? 'btn--primary' : 'btn--gold']}
              type="button"
              data-add={`Barca ${c.name}`}
              data-price={c.price}
              data-detail={`${c.pieces} pezzi`}
            >
              <span data-add-label>Aggiungi la Barca {c.name}</span> <Icon name="plus" class="btn__arrow" />
            </button>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
